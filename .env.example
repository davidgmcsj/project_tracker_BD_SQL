# Copiar este archivo a ".env" (sin ".example") y rellenar los valores
# reales. docker-compose.yml lee ".env" automáticamente. NUNCA subir el
# ".env" real al repositorio.

# ── Base de datos Azure SQL ─────────────────────────────────────────────────
DB_SERVER=
DB_NAME=
DB_USER=
DB_PASSWORD=

# ── Clave compartida para el header X-API-Key ───────────────────────────────
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
API_KEY=

# ── Origen exacto del frontend, para CORS ───────────────────────────────────
# Debe coincidir EXACTAMENTE con la URL que vas a usar en el navegador
# (protocolo + host, sin barra final). Ejemplo: https://192.168.1.50
FRONTEND_URL=

# ── Proveedores de IA (opcionales — si faltan, solo fallan 3 rutas de IA) ───
GEMINI_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
