# Copiar a ".env" (sin ".example") y rellenar. docker-compose.yml lo lee
# automáticamente si está en esta misma carpeta. NUNCA subir el ".env" real
# al repositorio (ya está en .gitignore).

# ── Base de datos Azure SQL ─────────────────────────────────────────────────
DB_SERVER=
DB_NAME=
DB_USER=
DB_PASSWORD=

# ── Clave compartida para el header X-API-Key ───────────────────────────────
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Debe coincidir con la que se use en el .env del repo del FRONTEND
# (ahí se llama API_KEY también, se pasa como build arg VITE_API_KEY).
API_KEY=

# ── Origen exacto del frontend, para CORS ───────────────────────────────────
# https://<dominio-o-ip-del-servidor> (sin barra final).
FRONTEND_URL=

# ── Proveedores de IA (opcionales — si faltan, solo fallan 3 rutas de IA) ───
GEMINI_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
