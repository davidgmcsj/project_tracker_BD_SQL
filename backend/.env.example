# Copiar a .env y completar con valores reales. Nunca commitear .env.

NODE_ENV=development
PORT=3002

# Origen permitido por CORS. Obligatorio en producción (falla al arrancar si falta).
FRONTEND_URL=http://localhost:5173

# Clave compartida exigida en el header X-API-Key para todo /api/*.
# Obligatoria en producción (falla al arrancar si falta); en desarrollo solo avisa.
API_KEY=

# Azure SQL / SQL Server
DB_SERVER=localhost
DB_USER=
DB_PASSWORD=
DB_NAME=

# Proveedores de IA para informes de gestión (opcionales, en cascada: Gemini → OpenRouter → Groq)
GEMINI_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
